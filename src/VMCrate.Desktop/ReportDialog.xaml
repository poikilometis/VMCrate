<Window x:Class="VMCrate.Desktop.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" ShowInTaskbar="False">
  <Border Style="{StaticResource Surface}" Margin="16" Padding="20">
    <StackPanel>
      <TextBlock Text="{Binding [tools.report]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding [hint.report]}" Style="{StaticResource MutedText}" Margin="0,4,0,16" />
      <TextBlock Text="{Binding [report.machine]}" Margin="0,0,0,4" />
      <ComboBox x:Name="ReportMachine" DisplayMemberPath="Name" SelectedValuePath="Id"
                AutomationProperties.Name="{Binding [report.machine]}" SelectionChanged="OnMachineChanged" />
      <WrapPanel Margin="0,12,0,0">
        <Button Content="{Binding [report.addFiles]}" Click="OnSelectFiles" />
        <Button x:Name="ClearButton" Content="{Binding [report.clearFiles]}" IsEnabled="False" Click="OnClearFiles" />
      </WrapPanel>
      <TextBlock x:Name="FileSummary" Style="{StaticResource MutedText}" />
      <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
        <Button Content="{Binding [action.cancel]}" IsCancel="True" />
        <Button x:Name="SaveButton" IsDefault="True" Content="{Binding [action.save]}"
                Style="{StaticResource PrimaryButton}" Click="OnSave" />
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
