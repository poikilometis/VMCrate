<Window x:Class="VMCrate.Desktop.SetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" ShowInTaskbar="False">
  <Border Style="{StaticResource Surface}" Margin="16" Padding="20">
    <StackPanel>
      <TextBlock x:Name="DialogHeading" Style="{StaticResource Heading}" Margin="0,0,0,12" />
      <TextBlock x:Name="DialogHint" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
      <TextBlock Text="{Binding [label.name]}" Margin="0,0,0,4" />
      <TextBox x:Name="NameInput" MaxLength="64" Margin="0,0,0,12" AutomationProperties.Name="{Binding [label.name]}" />
      <StackPanel x:Name="GuestFields" Margin="0,0,0,12">
        <TextBlock Text="{Binding [label.guest]}" Margin="0,0,0,4" />
        <ComboBox x:Name="GuestPicker" DisplayMemberPath="Name" SelectedValuePath="Guest"
                  AutomationProperties.Name="{Binding [label.guest]}" />
        <CheckBox x:Name="SecureBootBox" Content="{Binding [label.secureBoot]}" IsChecked="True" Margin="0,8,0,0" />
      </StackPanel>
      <StackPanel x:Name="MediaFields" Margin="0,0,0,12">
        <TextBlock x:Name="MediaLabel" Margin="0,0,0,4" />
        <DockPanel>
          <Button Content="{Binding [action.browse]}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowse" />
          <TextBox x:Name="MediaInput" IsReadOnly="True" FlowDirection="LeftToRight"
                   AutomationProperties.Name="{Binding Text, ElementName=MediaLabel}" />
        </DockPanel>
      </StackPanel>
      <Grid x:Name="ResourceFields" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding [label.memory]}" Margin="0,0,0,4" />
          <TextBox x:Name="MemoryInput" Text="4" AutomationProperties.Name="{Binding [label.memory]}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding [label.cpu]}" Margin="0,0,0,4" />
          <TextBox x:Name="CpuInput" Text="2" AutomationProperties.Name="{Binding [label.cpu]}" />
        </StackPanel>
      </Grid>
      <StackPanel x:Name="DiskFields" Margin="0,0,0,12">
        <TextBlock Text="{Binding [label.disk]}" Margin="0,0,0,4" />
        <TextBox x:Name="DiskInput" Text="64" AutomationProperties.Name="{Binding [label.disk]}" />
      </StackPanel>
      <TextBlock x:Name="ValidationMessage" Foreground="{StaticResource Notice}" Margin="0,0,0,8" Visibility="Collapsed" />
      <WrapPanel Margin="0,4,0,-8" HorizontalAlignment="Right">
        <Button Content="{Binding [action.cancel]}" IsCancel="True" />
        <Button x:Name="AcceptButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnAccept" />
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
