<Window x:Class="VMCrate.Desktop.BlueprintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="515" MinWidth="480" MinHeight="350" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding [tools.blueprint]}" Style="{StaticResource Heading}" />
    <StackPanel Grid.Row="1" Margin="0,4,0,16">
      <TextBlock x:Name="Summary" FontWeight="SemiBold" />
      <TextBlock Text="{Binding [hint.deploy]}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
    </StackPanel>
    <ListBox Grid.Row="2" x:Name="PlanRows" AutomationProperties.Name="{Binding [tools.blueprint]}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right">
      <Button Content="{Binding [action.cancel]}" IsCancel="True" />
      <Button x:Name="DeployButton" Content="{Binding [action.deploy]}" IsDefault="True"
              Style="{StaticResource PrimaryButton}" Click="OnDeploy" />
    </WrapPanel>
  </Grid>
</Window>
