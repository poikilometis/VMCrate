<Window x:Class="VMCrate.Desktop.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMCrate" Width="1080" Height="740" MinWidth="760" MinHeight="570"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="LabRow">
      <StackPanel Margin="2,4">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="True" Margin="0,0,0,16">
      <ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="180" VerticalAlignment="Center"
                DisplayMemberPath="NativeName" SelectedValuePath="Id" SelectionChanged="OnLanguageChanged"
                AutomationProperties.Name="{Binding [label.language]}" />
      <TextBlock Text="VMCrate" Style="{StaticResource Heading}" FontSize="30" VerticalAlignment="Center" />
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
      <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="{Binding [action.refresh]}" Click="OnRefresh" />
      <Button DockPanel.Dock="Right" x:Name="HostDetailsButton" Content="{Binding [action.details]}"
              Visibility="Collapsed" Click="OnHostDetails" />
      <Button DockPanel.Dock="Right" x:Name="RecoveryShortcut" Content="{Binding [tools.recovery]}" Click="OnRecovery" Visibility="Collapsed" />
      <TextBlock x:Name="HostSummary" VerticalAlignment="Center" Margin="0,0,16,8" />
    </DockPanel>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Padding="8" Background="{StaticResource Canvas}"
                BorderBrush="{StaticResource Rule}">
      <TabItem Header="{Binding [home.title]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8,12,8,8">
            <Border Style="{StaticResource Surface}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock x:Name="ResumeTitle" Style="{StaticResource Heading}" FontSize="24" />
                <TextBlock x:Name="ResumeDetail" Style="{StaticResource MutedText}" Margin="0,6,0,12"
                           AutomationProperties.LiveSetting="Polite" />
                <WrapPanel>
                  <Button x:Name="ResumeAction" Style="{StaticResource PrimaryButton}" Click="OnResumeWork" />
                  <Button Content="{Binding [tools.session]}" Click="OnCleanSession" />
                  <Button Content="{Binding [jobs.title]}" Click="OnLocalJobs" />
                  <Button Content="{Binding [resources.title]}" Click="OnResourcePlan" />
                  <Button x:Name="ExplainFailure" Content="{Binding [ai.explain]}" Click="OnExplainFailure" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Button Content="{Binding [tools.journal]}" HorizontalAlignment="Left" Click="OnOperationJournal" />
            <ListBox x:Name="RecentOperations" MaxHeight="184" AutomationProperties.Name="{Binding [tools.journal]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding [tab.machines]}">
        <Grid Margin="8,12,8,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Button x:Name="CreateInstallerButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                  Content="{Binding [action.newInstaller]}" Click="OnNewInstaller" />
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Surface}" Padding="0">
              <Grid>
                <ListBox x:Name="MachineList" ItemTemplate="{StaticResource LabRow}" BorderThickness="0"
                         Background="Transparent" SelectionChanged="OnMachineChanged"
                         AutomationProperties.Name="{Binding [tab.machines]}" />
                <TextBlock x:Name="EmptyMachines" Margin="16" Text="{Binding [empty.machines]}" Style="{StaticResource MutedText}" />
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Surface}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock x:Name="MachineTitle" Style="{StaticResource Heading}" />
                  <TextBlock x:Name="MachineSummary" Style="{StaticResource MutedText}" Margin="0,4,0,16" />
                  <StackPanel x:Name="MachineActions" Visibility="Collapsed">
                    <WrapPanel>
                      <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="{Binding [action.start]}" Click="OnStart" />
                      <Button x:Name="ConsoleButton" Style="{StaticResource PrimaryButton}" Content="{Binding [action.console]}" Click="OnConsole" />
                      <Button Content="{Binding [tools.console]}" Click="OnConsoleTools" />
                      <Button x:Name="PowerButton" Content="{Binding [action.powerOff]}" Click="OnPowerOff" />
                    </WrapPanel>
                    <Separator Margin="0,8,0,12" Background="{StaticResource Rule}" />
                    <TextBlock Text="{Binding [label.network]}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel LastChildFill="True">
                      <Button x:Name="ApplyNetworkButton" DockPanel.Dock="Right" Content="{Binding [action.apply]}" Click="OnSetNetwork" />
                      <ComboBox x:Name="NetworkPicker" Margin="0,0,8,8" DisplayMemberPath="Name" SelectedValuePath="Mode"
                                AutomationProperties.Name="{Binding [label.network]}" />
                    </DockPanel>
                    <TextBlock x:Name="AuditSummary" Margin="0,4,0,16" />
                    <WrapPanel>
                      <Button x:Name="SendButton" Content="{Binding [action.send]}" Click="OnSend" />
                      <Button x:Name="EjectInboxButton" Content="{Binding [action.ejectInbox]}" Click="OnEjectInbox" />
                      <Button x:Name="EjectInstallerButton" Content="{Binding [action.ejectInstaller]}" Click="OnEjectInstaller" />
                    </WrapPanel>
                    <WrapPanel>
                      <Button x:Name="CaptureButton" Content="{Binding [action.capture]}" Click="OnCapture" />
                      <Button x:Name="ResetButton" Content="{Binding [action.reset]}" Click="OnReset" />
                      <Button x:Name="DiskRecoveryButton" Content="{Binding [points.title]}" Click="OnDiskRecovery" />
                      <Button x:Name="RemoveMachineButton" Content="{Binding [action.removeVm]}" Click="OnRemoveMachine" />
                      <Button Content="{Binding [action.vmReport]}" Click="OnMachineReport" />
                      <Button Content="{Binding [tools.isolation]}" Click="OnMachineIsolation" />
                      <Button x:Name="ProxyTraceButton" Content="{Binding [tools.proxyTrace]}" Click="OnProxyTrace" />
                      <Button x:Name="UpdateProxyButton" Content="{Binding [tools.updates]}" Click="OnUpdateProxy" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding [tab.templates]}">
        <Grid Margin="8,12,8,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Button x:Name="ImportTemplateButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                  Content="{Binding [action.importTemplate]}" Click="OnImport" />
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Surface}" Padding="0">
              <Grid>
                <ListBox x:Name="TemplateList" ItemTemplate="{StaticResource LabRow}" BorderThickness="0"
                         Background="Transparent" SelectionChanged="OnTemplateChanged"
                         AutomationProperties.Name="{Binding [tab.templates]}" />
                <TextBlock x:Name="EmptyTemplates" Margin="16" Text="{Binding [empty.templates]}" Style="{StaticResource MutedText}" />
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock x:Name="TemplateTitle" Style="{StaticResource Heading}" />
                <TextBlock x:Name="TemplateSummary" Style="{StaticResource MutedText}" Margin="0,4,0,16" />
                <WrapPanel x:Name="TemplateActions" Visibility="Collapsed">
                  <Button x:Name="CloneButton" Style="{StaticResource PrimaryButton}" Content="{Binding [action.clone]}" Click="OnClone" />
                  <Button x:Name="DisposableButton" Content="{Binding [action.disposable]}" Click="OnDisposable" />
                  <Button Content="{Binding [action.verifyTemplate]}" Click="OnVerifyTemplate" />
                  <Button Content="{Binding [jobs.background]}" Click="OnVerifyInBackground" />
                  <Button Content="{Binding [tools.revisions]}" Click="OnTemplateRevisions" />
                  <Button x:Name="RemoveTemplateButton" Content="{Binding [action.removeTemplate]}" Click="OnRemoveTemplate" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding [tab.tools]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8,12,8,8">
            <WrapPanel Margin="0,0,0,4">
              <Button Content="{Binding [first.title]}" Click="OnFirstMachine" />
              <Button Content="{Binding [tools.recovery]}" Click="OnRecovery" />
              <Button Content="{Binding [tools.firstRun]}" Click="OnFirstRun" />
              <Button Content="{Binding [tools.diagnostics]}" Click="OnDiagnostics" />
              <Button Content="{Binding [tools.isolation]}" Click="OnIsolation" />
              <Button Content="{Binding [tools.support]}" Click="OnSupport" />
              <Button Content="{Binding [tools.help]}" Click="OnTroubleshooting" />
              <Button Content="{Binding [tools.images]}" Click="OnImages" />
              <Button Content="{Binding [recipes.title]}" Click="OnRecipes" />
              <Button Content="{Binding [tools.builds]}" Click="OnBuilds" />
              <Button Content="{Binding [tools.labs]}" Click="OnLabs" />
              <Button Content="{Binding [backup.title]}" Click="OnLabBackup" />
              <Button Content="{Binding [tools.storage]}" Click="OnStorage" />
              <Button Content="{Binding [tools.session]}" Click="OnCleanSession" />
              <Button Content="{Binding [outbox.title]}" Click="OnOutbox" />
              <Button Content="{Binding [appUpdate.title]}" Click="OnAppUpdate" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
              <Button Content="{Binding [tools.ai]}" Click="OnAssistantSettings" />
              <Button Content="{Binding [tools.aiBlueprint]}" Click="OnDescriptionBlueprint" />
              <Button Content="{Binding [tools.sessionReport]}" Click="OnSessionReports" />
              <Button Content="{Binding [tools.advisor]}" Click="OnAdvisor" />
              <Button Content="{Binding [tools.projects]}" Click="OnProjects" />
              <Button Content="{Binding [transfer.title]}" Click="OnMachineTransfer" />
              <Button Content="{Binding [remote.title]}" Click="OnRemoteQueue" />
              <Button Content="{Binding [tools.journal]}" Click="OnOperationJournal" />
            </WrapPanel>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding [tools.blueprint]}" Style="{StaticResource Heading}" FontSize="18" />
                <TextBlock Text="{Binding [hint.blueprint]}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                <Button x:Name="PreviewBlueprintButton" Content="{Binding [action.previewBlueprint]}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnBlueprint" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Windows Sandbox" Style="{StaticResource Heading}" FontSize="18" />
                <TextBlock Text="{Binding [hint.sandbox]}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                <WrapPanel>
                  <Button x:Name="OpenSandboxButton" Content="{Binding [action.openSandbox]}" Click="OnSandbox" />
                  <Button Content="{Binding [action.exportSandbox]}" Click="OnExportSandbox" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="{Binding [tools.report]}" Style="{StaticResource Heading}" FontSize="18" />
                <TextBlock Text="{Binding [hint.report]}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                <Button Content="{Binding [action.createReport]}" HorizontalAlignment="Left" Click="OnReport" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="OperationStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                 AutomationProperties.LiveSetting="Polite" />
      <ProgressBar x:Name="WorkingBar" Grid.Column="1" Height="4" IsIndeterminate="True"
                   Foreground="{StaticResource Accent}" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
